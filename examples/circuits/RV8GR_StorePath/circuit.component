use standard.digital as digital;
use standard.memory as memory;

component:component RV8GR_StorePath is components.digital {
  title "RV8GR store path (AC→IBUS→DBUS→RAM without bus contention)";

  -- Public boundary ports
  port T2 : digital, input;
  port STR : digital, input;
  port A15 : digital, input;
  port AC[8] : digital, input;
  port IBUS[8] : digital, inout;
  port DBUS[8] : digital, inout;

  -- Devices
  device U14, digital.74HC541;    -- AC output buffer → IBUS
  device U7, digital.74HC245;     -- IBUS→DBUS write bridge
  device U24, digital.74HC04;     -- Creates /A15 and BUF_OE_N
  device U26, digital.74HC00;     -- /AC_BUF = NAND(T2, STR)
  device U28, digital.74HC86;     -- WR_DIR = NOT(/AC_BUF) via XOR(x, VCC)
  device ROM1, memory.AT28C256;  -- Disabled during store
  device RAM1, memory.62256;     -- Write target

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net t2 : digital;
  net str : digital;
  net a15 : digital;
  net a15_n : digital;
  bus ac[8] : digital;
  bus ibus[8] : digital;
  bus dbus[8] : digital;
  net ac_buf_n : digital;
  net wr_dir : digital;
  net buf_oe_safe : digital;

  -- Power  connect vcc -> U14.VCC;
  connect vcc -> U7.VCC;
  connect vcc -> U24.VCC;
  connect vcc -> U26.VCC;
  connect vcc -> U28.VCC;  connect gnd -> U14.GND;
  connect gnd -> U7.GND;
  connect gnd -> U24.GND;
  connect gnd -> U26.GND;
  connect gnd -> U28.GND;

  -- /AC_BUF = NAND(T2, STR) — U26 gate 3
  connect t2 -> U26.3A;
  connect str -> U26.3B;
  connect U26.3Y -> ac_buf_n;

  -- WR_DIR = NOT(/AC_BUF) — U28 gate 3 (XOR with VCC = invert)
  connect ac_buf_n -> U28.3A;
  connect vcc -> U28.3B;
  connect U28.3Y -> wr_dir;

  -- U14: AC output buffer
  -- /OE1 = /AC_BUF, /OE2 = /AC_BUF
  connect ac_buf_n -> U14./OE1;
  connect ac_buf_n -> U14./OE2;
  -- A inputs from AC
  connect ac[0] -> U14.A1;
  connect ac[1] -> U14.A2;
  connect ac[2] -> U14.A3;
  connect ac[3] -> U14.A4;
  connect ac[4] -> U14.A5;
  connect ac[5] -> U14.A6;
  connect ac[6] -> U14.A7;
  connect ac[7] -> U14.A8;
  -- Y outputs drive IBUS
  connect U14.Y1 -> ibus[0];
  connect U14.Y2 -> ibus[1];
  connect U14.Y3 -> ibus[2];
  connect U14.Y4 -> ibus[3];
  connect U14.Y5 -> ibus[4];
  connect U14.Y6 -> ibus[5];
  connect U14.Y7 -> ibus[6];
  connect U14.Y8 -> ibus[7];

  -- U7: IBUS→DBUS bridge (A-side=IBUS, B-side=DBUS)
  -- DIR=1 (WR_DIR=1): A→B = IBUS→DBUS
  -- /OE controlled by BUF_OE_SAFE (store path: U7 must be re-enabled for write)
  connect wr_dir -> U7.DIR;
  -- For store: /OE must be LOW to enable U7 for IBUS→DBUS
  -- In the full system, BUF_OE_SAFE=1 during store blocks U7
  -- But the actual store uses /AC_BUF directly to gate U7 /OE for write direction
  -- This is the isolated store path — U7 /OE tied to ac_buf_n for store proof
  connect ac_buf_n -> U7./OE;
  -- A-side from IBUS
  connect ibus[0] -> U7.A1;
  connect ibus[1] -> U7.A2;
  connect ibus[2] -> U7.A3;
  connect ibus[3] -> U7.A4;
  connect ibus[4] -> U7.A5;
  connect ibus[5] -> U7.A6;
  connect ibus[6] -> U7.A7;
  connect ibus[7] -> U7.A8;
  -- B-side drives DBUS
  connect U7.B1 -> dbus[0];
  connect U7.B2 -> dbus[1];
  connect U7.B3 -> dbus[2];
  connect U7.B4 -> dbus[3];
  connect U7.B5 -> dbus[4];
  connect U7.B6 -> dbus[5];
  connect U7.B7 -> dbus[6];
  connect U7.B8 -> dbus[7];

  -- /A15 for RAM chip select
  connect a15 -> U24.5A;
  connect U24.5Y -> a15_n;

  -- ROM disabled during store: /CE=A15, /OE=GND (always, but /CE gates)
  connect a15 -> ROM1./CE;
  connect gnd -> ROM1./OE;

  -- RAM: /CE=/A15, /WE=/AC_BUF (write strobe)
  connect a15_n -> RAM1./CE;
  connect ac_buf_n -> RAM1./WE;
  connect gnd -> RAM1./OE;

  -- Boundary port bindings
  connect T2 -> t2;
  connect STR -> str;
  connect A15 -> a15;
  connect AC -> ac;
  connect ibus -> IBUS;
  connect dbus -> DBUS;

  -- Derived signals
  derive store_active = ~ac_buf_n;
  derive ram_write_enabled = a15 & ~ac_buf_n;
  derive rom_safe = a15 | ac_buf_n;

  -- Clock (level-sensitive, combinational)
  clock sys_clk, t2, { "period_ns": 200, "initial": 0 };

  -- Input presets
  input no_store {
    set t2 = 0; set str = 0;
  }

  input store_ram {
    set t2 = 1; set str = 1; set a15 = 1;
  }

  input store_rom_page {
    set t2 = 1; set str = 1; set a15 = 0;
  }

  -- Reset
  reset power_on {
    apply no_store;
    set ac = 8'h00;
    settle;
    expect ac_buf_n == 1;
    expect wr_dir == 0;
  }

  -- Sequence: store activation
  sequence store_path_activation after power_on {
    apply no_store; settle;
    expect ac_buf_n == 1;
    expect wr_dir == 0;

    apply store_ram; settle;
    expect ac_buf_n == 0;
    expect wr_dir == 1;
    expect store_active == 1;
  }

  -- Edge criteria
  edge_criteria U14 {
    trigger none;
    level_sensitive /OE1, /OE2;
  }

  edge_criteria U7 {
    trigger none;
    level_sensitive DIR, /OE;
  }

  -- Bus safety
  bus_safety ibus_store_ownership {
    bus ibus;
    max_drivers 1;
    policy exclusive_tristate;
    drivers U14.Y;
    note "During store, only U14 drives IBUS. U34 and U7 (DBUS→IBUS) are disabled.";
  }

  bus_safety dbus_store_ownership {
    bus dbus;
    max_drivers 1;
    policy exclusive_tristate;
    drivers U7.B;
    note "During store, U7 writes IBUS→DBUS (DIR=1). ROM output disabled by /CE. RAM in write mode.";
  }

  -- Timing checks
  timing_check str_to_ac_buf {
    from str;
    through U26.3Y;
    to U14./OE1;
    expect 12ns;
    limit 20ns;
  }

  timing_check ac_to_ram_data {
    from ac[0];
    through U14.Y1;
    through U7.B1;
    to RAM1.D0;
    expect 27ns;
    limit 50ns;
  }

  -- Probes
  probe ac_data, ac;
  probe ibus_data, ibus;
  probe dbus_data, dbus;
  probe store_flag, store_active;
  probe ram_write, ram_write_enabled;

  display ac_data as bus_hex, { "label": "AC[7:0]" };
  display ibus_data as bus_hex, { "label": "IBUS (store)" };
  display dbus_data as bus_hex, { "label": "DBUS (to RAM)" };
  display store_flag as value, { "label": "STORE active" };

  -- Tests
  test t0_no_store {
    set t2 = 0; set str = 0;
    set ac = 8'h42;
    settle;
    assert ac_buf_n == 1;
    assert wr_dir == 0;
    note "No store during T0/T1: U14 disabled, U7 in read direction";
  }

  test t2_no_str {
    set t2 = 1; set str = 0;
    set ac = 8'h42;
    settle;
    assert ac_buf_n == 1;
    assert wr_dir == 0;
    note "T2 without STR: no store path activation";
  }

  test t2_store_ram {
    set t2 = 1; set str = 1; set a15 = 1;
    set ac = 8'hA5;
    settle;
    assert ac_buf_n == 0;
    assert wr_dir == 1;
    assert ibus == 8'hA5;
    assert dbus == 8'hA5;
    note "AC=$A5 → IBUS → U7 → DBUS → RAM (A15=1 selects RAM)";
  }

  test t2_store_rom_page_safe {
    set t2 = 1; set str = 1; set a15 = 0;
    set ac = 8'hFF;
    settle;
    assert ac_buf_n == 0;
    assert wr_dir == 1;
    note "Store to ROM page: ROM /CE=0 but /WE is not active for ROM. Bus-safe but no write occurs.";
  }

  test bus_no_contention {
    set t2 = 1; set str = 1; set a15 = 1;
    set ac = 8'h55;
    settle;
    -- ROM disabled: /CE = A15 = 1
    -- RAM in write mode: /WE=0
    -- U14 drives IBUS, U7 bridges to DBUS
    assert store_active == 1;
    note "Single driver on IBUS (U14) and single driver on DBUS (U7). No contention.";
  }
}
