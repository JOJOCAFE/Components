use standard.digital as digital;

component:component RV8GR_AluAccumulator is components.digital {
  title "RV8GR ALU, accumulator, and Z flag (14 chips)";

  -- Public boundary ports
  port T2 : digital, input;
  port ALU_SUB : digital, input;
  port XOR_MODE : digital, input;
  port MUX_SEL : digital, input;
  port AC_WR : digital, input;
  port STR : digital, input;
  port IBUS[8] : digital, inout;
  port AC[8] : digital, output;
  port Z_flag : digital, output;

  -- Devices (14 chips)
  device U9, digital.74HC574;     -- Accumulator register
  device U10, digital.74HC283;    -- Low nibble adder
  device U11, digital.74HC283;    -- High nibble adder
  device U12, digital.74HC86;     -- Low nibble XOR bank
  device U13, digital.74HC86;     -- High nibble XOR bank
  device U14, digital.74HC541;    -- AC output buffer (store)
  device U17, digital.74HC157;    -- Low nibble AC input mux
  device U18, digital.74HC157;    -- High nibble AC input mux
  device U19, digital.74HC157;    -- Low nibble XOR B-input mux
  device U20, digital.74HC157;    -- High nibble XOR B-input mux
  device U21, digital.74HC74;     -- Z flag flip-flop
  device U22, digital.74HC688;    -- AC equals zero comparator
  device U26, digital.74HC00;     -- /AC_BUF = NAND(T2, STR)
  device U27, digital.74HC00;     -- ACC_CLK = T2 AND AC_WR

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net t2 : digital;
  net alu_sub : digital;
  net xor_mode : digital;
  net mux_sel : digital;
  net ac_wr : digital;
  net str : digital;
  bus ibus[8] : digital;
  bus ac[8] : digital;
  bus xor_b[8] : digital;
  bus xor_y[8] : digital;
  bus sum[8] : digital;
  bus ac_d[8] : digital;
  net carry_chain : digital;
  net acc_clk : digital;
  net ac_buf_n : digital;
  net zero_compare : digital;
  net z_flag : digital;

  -- Power (all 14 chips)
  connect vcc -> U9.VCC;
  connect vcc -> U10.VCC;
  connect vcc -> U11.VCC;
  connect vcc -> U12.VCC;
  connect vcc -> U13.VCC;
  connect vcc -> U14.VCC;
  connect vcc -> U17.VCC;
  connect vcc -> U18.VCC;
  connect vcc -> U19.VCC;
  connect vcc -> U20.VCC;
  connect vcc -> U21.VCC;
  connect vcc -> U22.VCC;
  connect vcc -> U26.VCC;
  connect vcc -> U27.VCC;
  connect gnd -> U9.GND;
  connect gnd -> U10.GND;
  connect gnd -> U11.GND;
  connect gnd -> U12.GND;
  connect gnd -> U13.GND;
  connect gnd -> U14.GND;
  connect gnd -> U17.GND;
  connect gnd -> U18.GND;
  connect gnd -> U19.GND;
  connect gnd -> U20.GND;
  connect gnd -> U21.GND;
  connect gnd -> U22.GND;
  connect gnd -> U26.GND;
  connect gnd -> U27.GND;

  -- ACC_CLK generation: U27 = NAND(T2, AC_WR), inverted = AND
  connect t2 -> U27.1A;
  connect ac_wr -> U27.1B;
  connect U27.1Y -> acc_clk;

  -- /AC_BUF generation: U26 = NAND(T2, STR)
  connect t2 -> U26.1A;
  connect str -> U26.1B;
  connect U26.1Y -> ac_buf_n;

  -- Accumulator register U9: captures on ACC_CLK rising
  connect acc_clk -> U9.CLK;
  connect U9.1Q -> ac[0];
  connect U9.2Q -> ac[1];
  connect U9.3Q -> ac[2];
  connect U9.4Q -> ac[3];
  connect U9.5Q -> ac[4];
  connect U9.6Q -> ac[5];
  connect U9.7Q -> ac[6];
  connect U9.8Q -> ac[7];
  connect ac_d[0] -> U9.1D;
  connect ac_d[1] -> U9.2D;
  connect ac_d[2] -> U9.3D;
  connect ac_d[3] -> U9.4D;
  connect ac_d[4] -> U9.5D;
  connect ac_d[5] -> U9.6D;
  connect ac_d[6] -> U9.7D;
  connect ac_d[7] -> U9.8D;

  -- XOR B-input mux: selects between ALU_SUB (for ADD/SUB) or AC (for XOR mode)
  connect xor_mode -> U19."A/B";
  connect xor_mode -> U20."A/B";
  -- U19 low nibble: A=ALU_SUB, B=AC[0..3]
  connect alu_sub -> U19.1A;
  connect alu_sub -> U19.2A;
  connect alu_sub -> U19.3A;
  connect alu_sub -> U19.4A;
  connect ac[0] -> U19.1B;
  connect ac[1] -> U19.2B;
  connect ac[2] -> U19.3B;
  connect ac[3] -> U19.4B;
  connect U19.1Y -> xor_b[0];
  connect U19.2Y -> xor_b[1];
  connect U19.3Y -> xor_b[2];
  connect U19.4Y -> xor_b[3];
  -- U20 high nibble: A=ALU_SUB, B=AC[4..7]
  connect alu_sub -> U20.1A;
  connect alu_sub -> U20.2A;
  connect alu_sub -> U20.3A;
  connect alu_sub -> U20.4A;
  connect ac[4] -> U20.1B;
  connect ac[5] -> U20.2B;
  connect ac[6] -> U20.3B;
  connect ac[7] -> U20.4B;
  connect U20.1Y -> xor_b[4];
  connect U20.2Y -> xor_b[5];
  connect U20.3Y -> xor_b[6];
  connect U20.4Y -> xor_b[7];
  connect gnd -> U19."/G";
  connect gnd -> U20."/G";

  -- XOR bank: IBUS XOR XOR_B -> XOR_Y
  -- U12 low nibble
  connect ibus[0] -> U12.1A;
  connect ibus[1] -> U12.2A;
  connect ibus[2] -> U12.3A;
  connect ibus[3] -> U12.4A;
  connect xor_b[0] -> U12.1B;
  connect xor_b[1] -> U12.2B;
  connect xor_b[2] -> U12.3B;
  connect xor_b[3] -> U12.4B;
  connect U12.1Y -> xor_y[0];
  connect U12.2Y -> xor_y[1];
  connect U12.3Y -> xor_y[2];
  connect U12.4Y -> xor_y[3];
  -- U13 high nibble
  connect ibus[4] -> U13.1A;
  connect ibus[5] -> U13.2A;
  connect ibus[6] -> U13.3A;
  connect ibus[7] -> U13.4A;
  connect xor_b[4] -> U13.1B;
  connect xor_b[5] -> U13.2B;
  connect xor_b[6] -> U13.3B;
  connect xor_b[7] -> U13.4B;
  connect U13.1Y -> xor_y[4];
  connect U13.2Y -> xor_y[5];
  connect U13.3Y -> xor_y[6];
  connect U13.4Y -> xor_y[7];

  -- Adder: AC + XOR_Y + SUB carry
  -- U10 low nibble
  connect ac[0] -> U10.A1;
  connect ac[1] -> U10.A2;
  connect ac[2] -> U10.A3;
  connect ac[3] -> U10.A4;
  connect xor_y[0] -> U10.B1;
  connect xor_y[1] -> U10.B2;
  connect xor_y[2] -> U10.B3;
  connect xor_y[3] -> U10.B4;
  connect alu_sub -> U10.C0;
  connect U10.S1 -> sum[0];
  connect U10.S2 -> sum[1];
  connect U10.S3 -> sum[2];
  connect U10.S4 -> sum[3];
  connect U10.C4 -> carry_chain;
  -- U11 high nibble
  connect carry_chain -> U11.C0;
  connect ac[4] -> U11.A1;
  connect ac[5] -> U11.A2;
  connect ac[6] -> U11.A3;
  connect ac[7] -> U11.A4;
  connect xor_y[4] -> U11.B1;
  connect xor_y[5] -> U11.B2;
  connect xor_y[6] -> U11.B3;
  connect xor_y[7] -> U11.B4;
  connect U11.S1 -> sum[4];
  connect U11.S2 -> sum[5];
  connect U11.S3 -> sum[6];
  connect U11.S4 -> sum[7];

  -- AC input mux: selects SUM (A) or XOR_Y (B)
  connect mux_sel -> U17."A/B";
  connect mux_sel -> U18."A/B";
  -- U17 low nibble
  connect sum[0] -> U17.1A;
  connect sum[1] -> U17.2A;
  connect sum[2] -> U17.3A;
  connect sum[3] -> U17.4A;
  connect xor_y[0] -> U17.1B;
  connect xor_y[1] -> U17.2B;
  connect xor_y[2] -> U17.3B;
  connect xor_y[3] -> U17.4B;
  connect U17.1Y -> ac_d[0];
  connect U17.2Y -> ac_d[1];
  connect U17.3Y -> ac_d[2];
  connect U17.4Y -> ac_d[3];
  -- U18 high nibble
  connect sum[4] -> U18.1A;
  connect sum[5] -> U18.2A;
  connect sum[6] -> U18.3A;
  connect sum[7] -> U18.4A;
  connect xor_y[4] -> U18.1B;
  connect xor_y[5] -> U18.2B;
  connect xor_y[6] -> U18.3B;
  connect xor_y[7] -> U18.4B;
  connect U18.1Y -> ac_d[4];
  connect U18.2Y -> ac_d[5];
  connect U18.3Y -> ac_d[6];
  connect U18.4Y -> ac_d[7];
  connect gnd -> U17."/G";
  connect gnd -> U18."/G";

  -- AC output buffer: drives IBUS during store
  connect ac_buf_n -> U14."/OE1";
  connect ac_buf_n -> U14."/OE2";
  connect ac[0] -> U14.A1;
  connect ac[1] -> U14.A2;
  connect ac[2] -> U14.A3;
  connect ac[3] -> U14.A4;
  connect ac[4] -> U14.A5;
  connect ac[5] -> U14.A6;
  connect ac[6] -> U14.A7;
  connect ac[7] -> U14.A8;
  connect U14.Y1 -> ibus[0];
  connect U14.Y2 -> ibus[1];
  connect U14.Y3 -> ibus[2];
  connect U14.Y4 -> ibus[3];
  connect U14.Y5 -> ibus[4];
  connect U14.Y6 -> ibus[5];
  connect U14.Y7 -> ibus[6];
  connect U14.Y8 -> ibus[7];

  -- Z flag: 74HC688 comparator (AC == 0?) + 74HC74 flip-flop (async preset)
  -- U22 compares AC[7:0] against 0x00; /Y goes LOW when equal
  -- U21./1PRE is driven by U22./Y: when AC==0, /Y=0 presets z_flag=1
  -- U21.1D tied to GND: on clock edge without preset, z_flag clears to 0
  connect ac[0] -> U22.A0;
  connect ac[1] -> U22.A1;
  connect ac[2] -> U22.A2;
  connect ac[3] -> U22.A3;
  connect ac[4] -> U22.A4;
  connect ac[5] -> U22.A5;
  connect ac[6] -> U22.A6;
  connect ac[7] -> U22.A7;
  connect gnd -> U22.B0;
  connect gnd -> U22.B1;
  connect gnd -> U22.B2;
  connect gnd -> U22.B3;
  connect gnd -> U22.B4;
  connect gnd -> U22.B5;
  connect gnd -> U22.B6;
  connect gnd -> U22.B7;
  connect gnd -> U22."/E";
  connect U22."/Y" -> zero_compare;
  connect zero_compare -> U21."/1PRE";
  connect gnd -> U21.1D;
  connect acc_clk -> U21.1CLK;
  connect vcc -> U21."/1CLR";
  connect U21.1Q -> z_flag;

  -- Boundary port bindings
  connect T2 -> t2;
  connect ALU_SUB -> alu_sub;
  connect XOR_MODE -> xor_mode;
  connect MUX_SEL -> mux_sel;
  connect AC_WR -> ac_wr;
  connect STR -> str;
  connect IBUS -> ibus;
  connect ac -> AC;
  connect z_flag -> Z_flag;

  -- Derived signals (control equations from horizontal architecture)
  derive acc_clk_equation = t2 & ac_wr;
  derive ac_buf_active = t2 & str;
  derive alu_add = ~xor_mode & ~mux_sel;
  derive alu_sub_mode = ~xor_mode & ~mux_sel & alu_sub;
  derive alu_xor = xor_mode & mux_sel;
  derive alu_li = ~xor_mode & mux_sel;

  -- Stimulus: clock
  clock phase_clk, t2, { "period_ns": 200, "initial": 0 };

  -- Stimulus: input presets
  input add_mode {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 1;
    set str = 0;
  }

  input sub_mode {
    set alu_sub = 1;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 1;
    set str = 0;
  }

  input xor_mode_preset {
    set alu_sub = 0;
    set xor_mode = 1;
    set mux_sel = 1;
    set ac_wr = 1;
    set str = 0;
  }

  input li_mode {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 1;
    set ac_wr = 1;
    set str = 0;
  }

  input store_mode {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 0;
    set str = 1;
  }

  -- Stimulus: reset
  reset clear_ac {
    apply li_mode;
    set ibus = 0x00;
    set t2 = 1;
    settle;
    set t2 = 0;
    settle;
    expect ac == 0x00;
    expect z_flag == 1;
  }

  -- Stimulus: step sequences
  step load_immediate {
    apply li_mode;
    set ibus = 0x42;
    set t2 = 1;
    settle;
    set t2 = 0;
    settle;
    probe;
  }

  step add_then_probe {
    apply add_mode;
    set ibus = 0x01;
    set t2 = 1;
    settle;
    set t2 = 0;
    settle;
    probe;
  }

  -- Bus safety: IBUS single-driver policy
  bus_safety ibus {
    reject multi_driver;
  }

  -- Edge criteria
  edge_criteria U9 {
    trigger rising;
    non_trigger hold;
  }

  edge_criteria U21 {
    trigger rising;
    non_trigger hold;
  }

  -- Policy: accumulator only captures during T2 with AC_WR
  policy acc_capture_safety {
    reject (acc_clk == 1) & (t2 == 0);
  }

  -- Timing checks
  timing_check alu_critical_path {
    from U12.1Y;
    through U10.S1;
    to U17.1Y;
    expect 40ns;
    limit 70ns;
  }

  timing_check acc_clk_to_z {
    from U9.CLK;
    through U22./Y;
    to U21.1Q;
    expect 50ns;
    limit 80ns;
  }

  -- Observation
  probe accumulator, ac;
  probe z, z_flag;
  probe ibus_val, ibus;
  probe clk_acc, acc_clk;
  display accumulator as value, { "label": "AC", "radix": "hex" };
  display z as led, { "label": "Z flag" };
  display ibus_val as value, { "label": "IBUS", "radix": "hex" };
  display clk_acc as waveform, { "label": "ACC_CLK" };

  -- Tests
  test load_immediate_42 {
    reset clear_ac;
    apply li_mode;
    set ibus = 0x42;
    set t2 = 1; settle;
    set t2 = 0; settle;
    -- Second pulse: z_flag latches D=0 now that AC≠0 and /1PRE=HIGH
    set t2 = 1; settle;
    set t2 = 0; settle;
    assert accumulator == 0x42;
    assert z == 0;
  }

  test add_01_to_42 {
    reset clear_ac;
    -- Load 0x42
    apply li_mode;
    set ibus = 0x42;
    set t2 = 1; settle; set t2 = 0; settle;
    -- Add 0x01
    apply add_mode;
    set ibus = 0x01;
    set t2 = 1; settle; set t2 = 0; settle;
    assert accumulator == 0x43;
    assert z == 0;
  }

  test sub_to_zero_sets_z {
    reset clear_ac;
    -- Load 0x05
    apply li_mode;
    set ibus = 0x05;
    set t2 = 1; settle; set t2 = 0; settle;
    -- Sub 0x05
    apply sub_mode;
    set ibus = 0x05;
    set t2 = 1; settle; set t2 = 0; settle;
    assert accumulator == 0x00;
    assert z == 1;
  }

  test store_drives_ibus {
    reset clear_ac;
    -- Load 0xAA
    apply li_mode;
    set ibus = 0xAA;
    set t2 = 1; settle; set t2 = 0; settle;
    -- Store: release IBUS, let buffer drive
    apply store_mode;
    release ibus;
    set t2 = 1; settle;
    assert ibus_val == 0xAA;
    assert ibus has single_driver;
  }

  test ibus_no_conflict_during_load {
    reset clear_ac;
    apply li_mode;
    set ibus = 0xFF;
    set t2 = 1; settle;
    assert ibus has no_conflict;
  }
}
