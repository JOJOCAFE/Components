use standard.digital as digital;
use standard.memory as memory;
use standard.virtual as virtual;
use project.RV8GR_AluAccumulator as AluAccumulator;
use project.RV8GR_BranchJumpControl as BranchJumpControl;

component:component RV8GR_Lab13MarkerTrace is components.digital {
  title "RV8GR Lab 13 marker trace: LI $10, ADDI $05, SUBI $15, BEQ $0C, LI $AA";

  -- Public boundary ports
  port CLK : digital, input;
  port /RST : digital, input;
  port T0 : digital, output;
  port T1 : digital, output;
  port T2 : digital, output;
  port PC[16] : digital, output;
  port AC[8] : digital, output;
  port Z_flag : digital, output;
  port PG[8] : digital, output;
  port DP[8] : digital, output;
  port IBUS[8] : digital, inout;
  port DBUS[8] : digital, inout;
  port /PC_LD : digital, output;

  -- Devices
  device U1, digital.74HC161;     -- PC bits 0-3
  device U2, digital.74HC161;     -- PC bits 4-7
  device U3, digital.74HC161;     -- PC bits 8-11
  device U4, digital.74HC161;     -- PC bits 12-15
  device U5, digital.74HC574;     -- IR_HIGH control latch
  device U6, digital.74HC574;     -- IR_LOW operand latch
  device U7, digital.74HC245;     -- DBUS↔IBUS bridge
  device U34, digital.74HC541;    -- IRL immediate buffer
  device ROM1, memory.AT28C256;   -- Program ROM

  -- Hierarchical sub-circuits
  instance alu, AluAccumulator;
  instance branch, BranchJumpControl;

  -- Virtual test helpers
  device VCLK, virtual.ClockSource, { "period_ns": 200 };
  device IBUSMON, virtual.BusProbe, { "width": 8, "policy": "single_driver" };
  device DBUSMON, virtual.BusProbe, { "width": 8, "policy": "single_driver" };

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net clk : digital;
  net rst_n : digital;
  net t0 : digital;
  net t1 : digital;
  net t2 : digital;
  bus pc[16] : digital;
  bus ac[8] : digital;
  bus pg[8] : digital;
  bus dp[8] : digital;
  bus ibus[8] : digital;
  bus dbus[8] : digital;
  bus irh[8] : digital;
  bus irl[8] : digital;
  net z_flag : digital;
  net pc_ld_n : digital;
  net pc_inc : digital;
  net acc_clk : digital;
  net wr_dir : digital;
  net buf_oe_n : digital;
  net ac_buf_n : digital;
  net irl_oe_n : digital;
  net jmp : digital;
  net br : digital;
  net alu_sub : digital;
  net xor_mode : digital;
  net mux_sel : digital;
  net ac_wr : digital;
  net str : digital;
  net src : digital;

  -- Power connections
  connect vcc -> U1.VCC;
  connect vcc -> U2.VCC;
  connect vcc -> U3.VCC;
  connect vcc -> U4.VCC;
  connect vcc -> U5.VCC;
  connect vcc -> U6.VCC;
  connect vcc -> U7.VCC;
  connect vcc -> U34.VCC;
  connect gnd -> U1.GND;
  connect gnd -> U2.GND;
  connect gnd -> U3.GND;
  connect gnd -> U4.GND;
  connect gnd -> U5.GND;
  connect gnd -> U6.GND;
  connect gnd -> U7.GND;
  connect gnd -> U34.GND;

  -- PC counter chain
  connect clk -> U1.CLK;
  connect clk -> U2.CLK;
  connect clk -> U3.CLK;
  connect clk -> U4.CLK;
  connect rst_n -> U1./CLR;
  connect rst_n -> U2./CLR;
  connect rst_n -> U3./CLR;
  connect rst_n -> U4./CLR;
  connect pc_ld_n -> U1./LOAD;
  connect pc_ld_n -> U2./LOAD;
  connect pc_ld_n -> U3./LOAD;
  connect pc_ld_n -> U4./LOAD;
  connect pc_inc -> U1.ENP;
  connect pc_inc -> U1.ENT;
  connect pc_inc -> U2.ENP;
  connect pc_inc -> U3.ENP;
  connect pc_inc -> U4.ENP;
  connect U1.RCO -> U2.ENT;
  connect U2.RCO -> U3.ENT;
  connect U3.RCO -> U4.ENT;

  -- Instruction latches
  connect t0 -> U5.CLK;     -- Control byte latched on T0 rising
  connect t1 -> U6.CLK;     -- Operand byte latched on T1 rising
  connect ibus -> U5.1D;     -- IBUS → control latch
  connect ibus -> U6.1D;     -- IBUS → operand latch
  connect gnd -> U5./OE;    -- Always output enabled
  connect gnd -> U6./OE;

  -- U7 bridge: DBUS ↔ IBUS
  connect wr_dir -> U7.DIR;
  connect buf_oe_n -> U7./OE;

  -- U34 IRL immediate buffer (drives IBUS during T2 for non-memory ops)
  connect irl_oe_n -> U34./OE1;
  connect irl_oe_n -> U34./OE2;

  -- ROM connections
  connect pc -> ROM1.A;      -- Address from PC during fetch
  connect ROM1.D -> dbus;    -- ROM drives DBUS

  -- ALU sub-circuit connections
  connect t2 -> alu.T2;
  connect alu_sub -> alu.ALU_SUB;
  connect xor_mode -> alu.XOR_MODE;
  connect mux_sel -> alu.MUX_SEL;
  connect ac_wr -> alu.AC_WR;
  connect str -> alu.STR;
  connect ibus -> alu.IBUS;
  connect alu.AC -> ac;
  connect alu.Z_flag -> z_flag;

  -- Branch/jump sub-circuit connections
  connect t0 -> branch.T0;
  connect t1 -> branch.T1;
  connect t2 -> branch.T2;
  connect jmp -> branch.JMP;
  connect br -> branch.BR;
  connect alu_sub -> branch.ALU_SUB;
  connect z_flag -> branch.Z_flag;
  connect branch./PC_LD -> pc_ld_n;

  -- Boundary port bindings
  connect CLK -> clk;
  connect /RST -> rst_n;
  connect t0 -> T0;
  connect t1 -> T1;
  connect t2 -> T2;
  connect pc -> PC;
  connect ac -> AC;
  connect z_flag -> Z_flag;
  connect pg -> PG;
  connect dp -> DP;
  connect ibus -> IBUS;
  connect dbus -> DBUS;
  connect pc_ld_n -> /PC_LD;

  -- IRH control bit mapping
  derive sub_bit = irh[7];
  derive xor_mode_bit = irh[6];
  derive mux_sel_bit = irh[5];
  derive ac_wr_bit = irh[4];
  derive src_bit = irh[3];
  derive str_bit = irh[2];
  derive br_bit = irh[1];
  derive jmp_bit = irh[0];

  -- Memory: Lab 13 marker program
  -- LI $10   → opcode $30 (MUX_SEL=1, AC_WR=1, XOR=0, SUB=0), operand $10
  -- ADDI $05 → opcode $10 (AC_WR=1), operand $05
  -- SUBI $15 → opcode $90 (SUB=1, AC_WR=1), operand $15
  -- BEQ $0C  → opcode $02 (BR=1), operand $0C
  -- LI $AA   → opcode $30, operand $AA
  memory ROM1 {
    0x0000 = [0x30, 0x10];  -- LI $10
    0x0002 = [0x10, 0x05];  -- ADDI $05
    0x0004 = [0x90, 0x15];  -- SUBI $15
    0x0006 = [0x02, 0x0C];  -- BEQ $0C
    0x0008 = [0x30, 0xAA];  -- LI $AA (marker — this is reached)
    0x000A = [0x00, 0x00];  -- NOP (padding)
    0x000C = [0x30, 0xAA];  -- LI $AA (branch target — also marker)
  }

  -- Stimulus: clock
  clock sys_clk, clk, { "period_ns": 200, "initial": 0 };

  -- Stimulus: input presets (per-instruction control word)
  input li_ctrl {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 1;
    set ac_wr = 1;
    set src = 0;
    set str = 0;
    set br = 0;
    set jmp = 0;
  }

  input addi_ctrl {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 1;
    set src = 0;
    set str = 0;
    set br = 0;
    set jmp = 0;
  }

  input subi_ctrl {
    set alu_sub = 1;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 1;
    set src = 0;
    set str = 0;
    set br = 0;
    set jmp = 0;
  }

  input beq_ctrl {
    set alu_sub = 0;
    set xor_mode = 0;
    set mux_sel = 0;
    set ac_wr = 0;
    set src = 0;
    set str = 0;
    set br = 1;
    set jmp = 0;
  }

  -- Stimulus: reset
  reset power_on {
    set rst_n = 0;
    settle;
    set rst_n = 1;
    settle;
    expect pc == 0x0000;
    expect ac == 0x00;
    expect z_flag == 0;
    expect pg == 0x00;
    expect dp == 0x80;
  }

  -- Step sequences for 15-clock trace
  step fetch_t0 {
    set t0 = 1; set t1 = 0; set t2 = 0;
    settle;
    -- ROM→DBUS→U7→IBUS→U5 (control latch)
    probe;
  }

  step fetch_t1 {
    set t0 = 0; set t1 = 1; set t2 = 0;
    settle;
    -- ROM→DBUS→U7→IBUS→U6 (operand latch)
    probe;
  }

  step execute_t2 {
    set t0 = 0; set t1 = 0; set t2 = 1;
    settle;
    probe;
  }

  -- Full 15-clock marker trace sequence
  sequence marker_trace after power_on {
    -- Instruction 1: LI $10 (AC=$10, Z=0)
    clock sys_clk; expect t0 == 1, pc == 0x0000;
    clock sys_clk; expect t1 == 1, pc == 0x0001;
    clock sys_clk; expect t2 == 1, ac == 0x10, z_flag == 0, pc == 0x0002;
    -- Instruction 2: ADDI $05 (AC=$10+$05=$15, Z=0)
    clock sys_clk; expect t0 == 1, pc == 0x0002;
    clock sys_clk; expect t1 == 1, pc == 0x0003;
    clock sys_clk; expect t2 == 1, ac == 0x15, z_flag == 0, pc == 0x0004;
    -- Instruction 3: SUBI $15 (AC=$15-$15=$00, Z=1)
    clock sys_clk; expect t0 == 1, pc == 0x0004;
    clock sys_clk; expect t1 == 1, pc == 0x0005;
    clock sys_clk; expect t2 == 1, ac == 0x00, z_flag == 1, pc == 0x0006;
    -- Instruction 4: BEQ $0C (Z=1, taken → PC=$000C)
    clock sys_clk; expect t0 == 1, pc == 0x0006;
    clock sys_clk; expect t1 == 1, pc == 0x0007;
    clock sys_clk; expect t2 == 1, pc == 0x000C, pc_ld_n == 0;
    -- Instruction 5: LI $AA at branch target (AC=$AA, Z=0)
    clock sys_clk; expect t0 == 1, pc == 0x000C;
    clock sys_clk; expect t1 == 1, pc == 0x000D;
    clock sys_clk; expect t2 == 1, ac == 0xAA, z_flag == 0, pc == 0x000E;
  }

  -- 5-step marker flow summary
  sequence marker_flow_summary after power_on {
    clock sys_clk 3; expect ac == 0x10;
    clock sys_clk 3; expect ac == 0x15;
    clock sys_clk 3; expect ac == 0x00, z_flag == 1;
    clock sys_clk 3; expect pc == 0x000C;
    clock sys_clk 3; expect ac == 0xAA, z_flag == 0;
  }

  -- Bus safety
  bus_safety ibus {
    reject multi_driver;
  }

  bus_safety dbus {
    reject multi_driver;
  }

  -- Edge criteria
  edge_criteria U5 {
    trigger rising;
    non_trigger hold;
  }

  edge_criteria U6 {
    trigger rising;
    non_trigger hold;
  }

  edge_criteria U1 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  -- Policy: bus driver per phase
  policy t0_t1_rom_drives_dbus {
    reject (t0 == 1) & (wr_dir == 1);
    reject (t1 == 1) & (wr_dir == 1);
  }

  -- Clock profiles
  clock_profile manual {
    clock sys_clk, clk, { "period_ns": 1000000 };
  }

  clock_profile target_5mhz {
    clock sys_clk, clk, { "period_ns": 200 };
  }

  -- Observation
  probe pc_val, pc;
  probe acc, ac;
  probe z, z_flag;
  probe bus_ibus, ibus;
  probe bus_dbus, dbus;
  probe ir_high, irh;
  probe ir_low, irl;
  probe pc_load, pc_ld_n;
  probe acc_clock, acc_clk;
  display pc_val as value, { "label": "PC", "radix": "hex" };
  display acc as value, { "label": "AC", "radix": "hex" };
  display z as led, { "label": "Z flag" };
  display bus_ibus as value, { "label": "IBUS", "radix": "hex" };
  display bus_dbus as value, { "label": "DBUS", "radix": "hex" };
  display ir_high as value, { "label": "IRH", "radix": "bin" };
  display ir_low as value, { "label": "IRL", "radix": "hex" };
  display pc_load as waveform, { "label": "/PC_LD" };
  display acc_clock as waveform, { "label": "ACC_CLK" };

  -- Tests
  test li_10_loads_accumulator {
    reset power_on;
    apply li_ctrl;
    set irl = 0x10;
    set t2 = 1; settle;
    set t2 = 0; settle;
    assert acc == 0x10;
    assert z == 0;
  }

  test addi_05_after_li_10 {
    reset power_on;
    -- LI $10
    apply li_ctrl;
    set irl = 0x10;
    set t2 = 1; settle; set t2 = 0; settle;
    -- ADDI $05
    apply addi_ctrl;
    set irl = 0x05;
    set t2 = 1; settle; set t2 = 0; settle;
    assert acc == 0x15;
    assert z == 0;
  }

  test subi_15_sets_zero {
    reset power_on;
    -- LI $10, ADDI $05 → AC=$15
    apply li_ctrl;
    set irl = 0x10;
    set t2 = 1; settle; set t2 = 0; settle;
    apply addi_ctrl;
    set irl = 0x05;
    set t2 = 1; settle; set t2 = 0; settle;
    -- SUBI $15 → AC=$00, Z=1
    apply subi_ctrl;
    set irl = 0x15;
    set t2 = 1; settle; set t2 = 0; settle;
    assert acc == 0x00;
    assert z == 1;
  }

  test beq_taken_to_0c {
    reset power_on;
    -- Setup Z=1
    apply li_ctrl;
    set irl = 0x00;
    set t2 = 1; settle; set t2 = 0; settle;
    -- BEQ $0C with Z=1
    apply beq_ctrl;
    set irl = 0x0C;
    set t2 = 1; settle;
    assert pc_load == 0;  -- /PC_LD active = taken
  }

  test final_state_ac_aa {
    reset power_on;
    -- Run full 15-clock program
    clock sys_clk 15;
    settle;
    assert pc_val == 0x000E;
    assert acc == 0xAA;
    assert z == 0;
  }
}
