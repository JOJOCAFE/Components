use standard.digital as digital;
use standard.memory as memory;
use standard.virtual as virtual;
use project.RV8GR_BranchJumpControl as BranchJumpControl;

component:component RV8GR_StoreLoadBranchTrace is components.digital {
  title "RV8GR store/load/branch instruction trace";

  -- Public boundary ports
  port CLK : digital, input;
  port /RST : digital, input;
  port T0 : digital, output;
  port T1 : digital, output;
  port T2 : digital, output;
  port PC[16] : digital, output;
  port AC[8] : digital, output;
  port Z_flag : digital, output;
  port IBUS[8] : digital, inout;
  port DBUS[8] : digital, inout;
  port ABUS[16] : digital, output;

  -- Devices
  device U1, digital.74HC161;     -- PC bits 0-3
  device U2, digital.74HC161;     -- PC bits 4-7
  device U3, digital.74HC161;     -- PC bits 8-11
  device U4, digital.74HC161;     -- PC bits 12-15
  device U7, digital.74HC245;     -- DBUS/IBUS bridge
  device U14, digital.74HC541;    -- AC output buffer (store)
  device U15, digital.74HC157;    -- Address mux bits 0-3
  device U16, digital.74HC157;    -- Address mux bits 4-7
  device U29, digital.74HC157;    -- Address mux bits 8-11
  device U30, digital.74HC157;    -- Address mux bits 12-15
  device U34, digital.74HC541;    -- IRL immediate buffer
  device RAM1, memory.62256;      -- 32KB SRAM

  -- Hierarchical sub-circuits
  instance branch, BranchJumpControl;

  -- Virtual test helpers
  device VCLK, virtual.ClockSource, { "period_ns": 200 };
  device IBUSMON, virtual.BusProbe, { "width": 8, "policy": "single_driver" };
  device DBUSMON, virtual.BusProbe, { "width": 8, "policy": "single_driver" };

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net clk : digital;
  net rst_n : digital;
  net t0 : digital;
  net t1 : digital;
  net t2 : digital;
  bus pc[16] : digital;
  bus ac[8] : digital;
  bus ibus[8] : digital;
  bus dbus[8] : digital;
  bus abus[16] : digital;
  bus irl[8] : digital;
  bus irh[8] : digital;
  bus dp[8] : digital;
  bus pg[8] : digital;
  net z_flag : digital;
  net pc_ld_n : digital;
  net pc_inc : digital;
  net wr_dir : digital;
  net buf_oe_n : digital;
  net ac_buf_n : digital;
  net addr_mode_n : digital;
  net addr_req : digital;
  net str : digital;
  net src : digital;
  net jmp : digital;
  net br : digital;
  net alu_sub : digital;
  net ac_wr : digital;
  net ram_we_n : digital;
  net ram_oe_n : digital;
  net a15 : digital;

  -- Power connections
  connect vcc -> U1.VCC;
  connect vcc -> U2.VCC;
  connect vcc -> U3.VCC;
  connect vcc -> U4.VCC;
  connect vcc -> U7.VCC;
  connect vcc -> U14.VCC;
  connect vcc -> U15.VCC;
  connect vcc -> U16.VCC;
  connect vcc -> U29.VCC;
  connect vcc -> U30.VCC;
  connect vcc -> U34.VCC;
  connect gnd -> U1.GND;
  connect gnd -> U2.GND;
  connect gnd -> U3.GND;
  connect gnd -> U4.GND;
  connect gnd -> U7.GND;
  connect gnd -> U14.GND;
  connect gnd -> U15.GND;
  connect gnd -> U16.GND;
  connect gnd -> U29.GND;
  connect gnd -> U30.GND;
  connect gnd -> U34.GND;

  -- PC counter chain
  connect clk -> U1.CLK;
  connect clk -> U2.CLK;
  connect clk -> U3.CLK;
  connect clk -> U4.CLK;
  connect rst_n -> U1./CLR;
  connect rst_n -> U2./CLR;
  connect rst_n -> U3./CLR;
  connect rst_n -> U4./CLR;
  connect pc_ld_n -> U1./LOAD;
  connect pc_ld_n -> U2./LOAD;
  connect pc_ld_n -> U3./LOAD;
  connect pc_ld_n -> U4./LOAD;
  connect pc_inc -> U1.ENP;
  connect pc_inc -> U1.ENT;
  connect pc_inc -> U2.ENP;
  connect pc_inc -> U3.ENP;
  connect pc_inc -> U4.ENP;
  connect U1.RCO -> U2.ENT;
  connect U2.RCO -> U3.ENT;
  connect U3.RCO -> U4.ENT;

  -- Address mux: /ADDR_MODE selects PC (=1) or {DP,IRL} (=0)
  connect addr_mode_n -> U15./G;
  connect addr_mode_n -> U16./G;
  connect addr_mode_n -> U29./G;
  connect addr_mode_n -> U30./G;

  -- U7 bridge direction and output enable
  connect wr_dir -> U7.DIR;
  connect buf_oe_n -> U7./OE;
  -- U7 data pins: A-side ↔ IBUS, B-side ↔ DBUS
  connect ibus[0] -> U7.A1; connect ibus[1] -> U7.A2;
  connect ibus[2] -> U7.A3; connect ibus[3] -> U7.A4;
  connect ibus[4] -> U7.A5; connect ibus[5] -> U7.A6;
  connect ibus[6] -> U7.A7; connect ibus[7] -> U7.A8;
  connect dbus[0] -> U7.B1; connect dbus[1] -> U7.B2;
  connect dbus[2] -> U7.B3; connect dbus[3] -> U7.B4;
  connect dbus[4] -> U7.B5; connect dbus[5] -> U7.B6;
  connect dbus[6] -> U7.B7; connect dbus[7] -> U7.B8;

  -- U14 AC output buffer
  connect ac_buf_n -> U14./OE1;
  connect ac_buf_n -> U14./OE2;

  -- U34 IRL immediate buffer (T2 without SRC/STR drives IRL→IBUS)
  -- Simplified: /OE tied for T2 immediate

  -- RAM control
  connect ram_we_n -> RAM1./WE;
  connect ram_oe_n -> RAM1./OE;
  connect a15 -> RAM1./CE;  -- RAM selected when A15=1 (inverted externally)

  -- Branch/jump sub-circuit connections
  connect t0 -> branch.T0;
  connect t1 -> branch.T1;
  connect t2 -> branch.T2;
  connect jmp -> branch.JMP;
  connect br -> branch.BR;
  connect alu_sub -> branch.ALU_SUB;
  connect z_flag -> branch.Z_flag;
  connect branch./PC_LD -> pc_ld_n;

  -- Boundary port bindings
  connect CLK -> clk;
  connect /RST -> rst_n;
  connect t0 -> T0;
  connect t1 -> T1;
  connect t2 -> T2;
  connect pc -> PC;
  connect ac -> AC;
  connect z_flag -> Z_flag;
  connect ibus -> IBUS;
  connect dbus -> DBUS;
  connect abus -> ABUS;

  -- Derived signals (horizontal control from IRH)
  derive str_active = irh[2];
  derive src_active = irh[3];
  derive addr_req_signal = irh[2] | irh[3];
  derive addr_mode_signal = ~(addr_req_signal & t2);
  derive wr_dir_signal = t2 & irh[2];
  derive ac_buf_active = t2 & irh[2];
  derive ram_write = t2 & irh[2] & a15;

  -- Memory: preload RAM with test data
  memory RAM1 {
    0x0000 = [0x00, 0x00, 0x00, 0x00];
    0x0010 = [0xFF, 0x42, 0xAA, 0x55];
  }

  -- Stimulus: clock
  clock sys_clk, clk, { "period_ns": 200, "initial": 0 };

  -- Stimulus: input presets
  input store_byte {
    -- SB: opcode = $04 (STR=1, others=0)
    set irh = 0x04;
    set str = 1;
    set src = 0;
    set jmp = 0;
    set wr_dir = 1;
    set buf_oe_n = 0;
    set br = 0;
    set ac_wr = 0;
    set alu_sub = 0;
  }

  input load_byte {
    -- LB: opcode = $08 (SRC=1, others=0)
    set irh = 0x08;
    set str = 0;
    set src = 1;
    set jmp = 0;
    set wr_dir = 0;
    set buf_oe_n = 0;
    set br = 0;
    set ac_wr = 1;
    set alu_sub = 0;
  }

  input branch_eq {
    -- BEQ: opcode = $02 (BR=1, SUB=0)
    set irh = 0x02;
    set str = 0;
    set src = 0;
    set jmp = 0;
    set br = 1;
    set ac_wr = 0;
    set alu_sub = 0;
  }

  input branch_ne {
    -- BNE: opcode = $82 (BR=1, SUB=1)
    set irh = 0x82;
    set str = 0;
    set src = 0;
    set jmp = 0;
    set br = 1;
    set ac_wr = 0;
    set alu_sub = 1;
  }

  -- Stimulus: reset
  reset power_on {
    set rst_n = 0;
    set z_flag = 1;
    settle;
    set rst_n = 1;
    settle;
    expect pc == 0x0000;
    expect z_flag == 1;
  }

  -- Step sequences for multi-cycle trace
  step store_to_ram {
    -- T2 store: AC → IBUS → U7 → DBUS → RAM
    apply store_byte;
    set t2 = 1;
    set ac = 0x42;
    set dp = 0x80;
    set irl = 0x10;
    settle;
    -- Bus ownership: U14 drives IBUS, U7 drives DBUS, RAM receives
    probe;
    set t2 = 0;
    settle;
  }

  step load_from_ram {
    -- T2 load: RAM → DBUS → U7 → IBUS → AC
    apply load_byte;
    set t2 = 1;
    set dp = 0x80;
    set irl = 0x10;
    release ibus;
    settle;
    -- Bus ownership: RAM drives DBUS, U7 drives IBUS
    probe;
    set t2 = 0;
    settle;
  }

  step branch_taken_z1 {
    -- BEQ taken: Z=1, PC loads target
    apply branch_eq;
    set t2 = 1;
    set z_flag = 1;
    set irl = 0x0C;
    set pg = 0x00;
    settle;
    probe;
    set t2 = 0;
    settle;
  }

  step branch_not_taken_z0 {
    -- BEQ not taken: Z=0, PC continues
    apply branch_eq;
    set t2 = 1;
    set z_flag = 0;
    set irl = 0x0C;
    settle;
    probe;
    set t2 = 0;
    settle;
  }

  -- Sequence: store then load readback trace
  sequence store_load_readback after power_on {
    -- Cycle 1-3: LI $42 (setup AC with store value)
    clock sys_clk; expect t0 == 1;
    clock sys_clk; expect t1 == 1;
    clock sys_clk; expect t2 == 1, ac == 0x42;
    -- Cycle 4-6: SB $10 (store AC=$42 to RAM[$8010])
    clock sys_clk; expect t0 == 1;
    clock sys_clk; expect t1 == 1;
    clock sys_clk; expect t2 == 1;
    -- Cycle 7-9: LB $10 (load from RAM[$8010] → AC)
    clock sys_clk; expect t0 == 1;
    clock sys_clk; expect t1 == 1;
    clock sys_clk; expect t2 == 1, ac == 0x42;
  }

  -- Sequence: BEQ taken vs not taken
  sequence branch_trace after power_on {
    -- BEQ with Z=1 → taken, PC loads IRL
    clock sys_clk; expect t0 == 1;
    clock sys_clk; expect t1 == 1;
    clock sys_clk; expect t2 == 1, pc_ld_n == 0;
    -- BEQ with Z=0 → not taken, PC increments
    clock sys_clk; expect t0 == 1;
    clock sys_clk; expect t1 == 1;
    clock sys_clk; expect t2 == 1, pc_ld_n == 1;
  }

  -- Bus safety: IBUS and DBUS single-driver policy
  bus_safety ibus {
    reject multi_driver;
  }

  bus_safety dbus {
    reject multi_driver;
  }

  -- Edge criteria
  edge_criteria U1 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  -- Policy: store never drives IBUS and DBUS in wrong direction
  policy store_bus_direction {
    reject (ac_buf_n == 0) & (wr_dir == 0);
  }

  policy load_bus_direction {
    reject (ram_oe_n == 0) & (wr_dir == 1);
  }

  -- Clock profiles
  clock_profile manual {
    clock sys_clk, clk, { "period_ns": 1000000 };
  }

  clock_profile target_5mhz {
    clock sys_clk, clk, { "period_ns": 200 };
  }

  -- Observation
  probe bus_ibus, ibus;
  probe bus_dbus, dbus;
  probe bus_abus, abus;
  probe acc, ac;
  probe z, z_flag;
  probe pc_val, pc;
  probe wr, wr_dir;
  probe pc_load, pc_ld_n;
  display bus_ibus as value, { "label": "IBUS", "radix": "hex" };
  display bus_dbus as value, { "label": "DBUS", "radix": "hex" };
  display bus_abus as value, { "label": "ABUS", "radix": "hex" };
  display acc as value, { "label": "AC", "radix": "hex" };
  display z as led, { "label": "Z flag" };
  display pc_val as value, { "label": "PC", "radix": "hex" };
  display wr as led, { "label": "WR_DIR" };
  display pc_load as led, { "label": "/PC_LD" };

  -- Tests
  test store_byte_to_ram {
    reset power_on;
    -- Setup: drive IBUS with store data
    set ibus = 0x42;
    -- T2 store: U7 DIR=1 (A→B = IBUS→DBUS), /OE=0
    apply store_byte;
    set t2 = 1;
    settle;
    -- IBUS driven with value
    assert bus_ibus == 0x42;
    -- U7 bridges IBUS → DBUS (DIR=1)
    assert bus_dbus == 0x42;
  }

  test load_byte_from_ram {
    reset power_on;
    -- T2 load: U7 DIR=0 (B→A = DBUS→IBUS), /OE=0
    apply load_byte;
    set t2 = 1;
    -- Simulate RAM output on DBUS (address path not wired in this trace)
    set dbus = 0x42;
    settle;
    -- U7 bridges DBUS → IBUS (DIR=0)
    assert bus_dbus == 0x42;
    assert bus_ibus == 0x42;
  }
  }

  test beq_taken_z_set {
    reset power_on;
    apply branch_eq;
    set t2 = 1;
    set z_flag = 1;
    settle;
    assert pc_load == 0;  -- /PC_LD active LOW = taken
  }

  test beq_not_taken_z_clear {
    reset power_on;
    apply branch_eq;
    set t2 = 1;
    set z_flag = 0;
    settle;
    assert pc_load == 1;  -- /PC_LD HIGH = not taken
  }
}
