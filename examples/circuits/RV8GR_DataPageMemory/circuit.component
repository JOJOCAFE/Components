use standard.digital as digital;
use standard.memory as memory;

component:component RV8GR_DataPageMemory is components.digital {
  title "RV8GR data page register + RAM (U32 74HC574 + U2 62256 + decode)";

  -- Public boundary ports
  port T2 : digital, input;
  port XOR_MODE : digital, input;
  port /ADDR_MODE : digital, input;
  port /AC_WR : digital, input;
  port IBUS[8] : digital, input;
  port IRL[8] : digital, input;
  port PC_HIGH[8] : digital, input;
  port WR_DIR : digital, input;
  port BUF_OE_N : digital, input;
  port DP[8] : digital, output;
  port ABUS[16] : digital, output;
  port DBUS[8] : digital, inout;

  -- Devices
  device U32, digital.74HC574;    -- Data page register
  device U33, digital.74HC21;     -- SETDP decode (4-input AND)
  device U29, digital.74HC157;    -- Address mux bits 8-11
  device U30, digital.74HC157;    -- Address mux bits 12-15
  device U24, digital.74HC04;     -- A15 inverter (for /CE generation)
  device U7, digital.74HC245;     -- DBUS↔IBUS bridge
  device ROM1, memory.AT28C256;   -- Program ROM
  device RAM1, memory.62256;      -- Data RAM

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net t2 : digital;
  net xor_mode : digital;
  net addr_mode_n : digital;
  net ac_wr_n : digital;
  net wr_dir : digital;
  net buf_oe_n : digital;
  net dp_load : digital;
  bus ibus[8] : digital;
  bus irl[8] : digital;
  bus pc_high[8] : digital;
  bus dp[8] : digital;
  bus abus[16] : digital;
  bus dbus[8] : digital;
  net a15 : digital;
  net a15_n : digital;

  -- Power
  connect vcc -> U32.VCC;
  connect vcc -> U33.VCC;
  connect vcc -> U29.VCC;
  connect vcc -> U30.VCC;
  connect vcc -> U24.VCC;
  connect vcc -> U7.VCC;
  connect vcc -> ROM1.VCC;
  connect vcc -> RAM1.VCC;
  connect gnd -> U32.GND;
  connect gnd -> U33.GND;
  connect gnd -> U29.GND;
  connect gnd -> U30.GND;
  connect gnd -> U24.GND;
  connect gnd -> U7.GND;
  connect gnd -> ROM1.GND;
  connect gnd -> RAM1.GND;

  -- SETDP decode: DP_Load = T2 AND XOR_MODE AND /ADDR_MODE AND /AC_WR
  -- U33 is 74HC21 (dual 4-input AND)
  connect t2 -> U33.1A;
  connect xor_mode -> U33.1B;
  connect addr_mode_n -> U33.1C;
  connect ac_wr_n -> U33.1D;
  connect U33.1Y -> dp_load;

  -- Data page register U32: captures IBUS on DP_Load rising
  connect dp_load -> U32.CLK;
  connect gnd -> U32./OE;          -- Outputs always enabled
  connect ibus[0] -> U32.1D;
  connect ibus[1] -> U32.2D;
  connect ibus[2] -> U32.3D;
  connect ibus[3] -> U32.4D;
  connect ibus[4] -> U32.5D;
  connect ibus[5] -> U32.6D;
  connect ibus[6] -> U32.7D;
  connect ibus[7] -> U32.8D;
  connect U32.1Q -> dp[0];
  connect U32.2Q -> dp[1];
  connect U32.3Q -> dp[2];
  connect U32.4Q -> dp[3];
  connect U32.5Q -> dp[4];
  connect U32.6Q -> dp[5];
  connect U32.7Q -> dp[6];
  connect U32.8Q -> dp[7];

  -- Address mux: /ADDR_MODE=0 selects DP (data page), =1 selects PC_HIGH
  -- U29: ABUS bits 8-11 from DP[0..3] (A-input) or PC_HIGH[0..3] (B-input)
  connect addr_mode_n -> U29."A/B";
  connect gnd -> U29./G;
  connect dp[0] -> U29.1A;
  connect pc_high[0] -> U29.1B;
  connect U29.1Y -> abus[8];
  connect dp[1] -> U29.2A;
  connect pc_high[1] -> U29.2B;
  connect U29.2Y -> abus[9];
  connect dp[2] -> U29.3A;
  connect pc_high[2] -> U29.3B;
  connect U29.3Y -> abus[10];
  connect dp[3] -> U29.4A;
  connect pc_high[3] -> U29.4B;
  connect U29.4Y -> abus[11];

  -- U30: ABUS bits 12-15 from DP[4..7] (A-input) or PC_HIGH[4..7] (B-input)
  connect addr_mode_n -> U30."A/B";
  connect gnd -> U30./G;
  connect dp[4] -> U30.1A;
  connect pc_high[4] -> U30.1B;
  connect U30.1Y -> abus[12];
  connect dp[5] -> U30.2A;
  connect pc_high[5] -> U30.2B;
  connect U30.2Y -> abus[13];
  connect dp[6] -> U30.3A;
  connect pc_high[6] -> U30.3B;
  connect U30.3Y -> abus[14];
  connect dp[7] -> U30.4A;
  connect pc_high[7] -> U30.4B;
  connect U30.4Y -> abus[15];

  -- Low address from IRL (bits 0-7)
  connect irl[0] -> abus[0];
  connect irl[1] -> abus[1];
  connect irl[2] -> abus[2];
  connect irl[3] -> abus[3];
  connect irl[4] -> abus[4];
  connect irl[5] -> abus[5];
  connect irl[6] -> abus[6];
  connect irl[7] -> abus[7];

  -- A15 determines ROM vs RAM selection
  connect abus[15] -> a15;

  -- A15 inverter for chip select
  connect a15 -> U24.1A;
  connect U24.1Y -> a15_n;

  -- ROM: /CE = A15 (A15=0 selects ROM)
  connect a15 -> ROM1./CE;
  connect gnd -> ROM1./OE;
  connect vcc -> ROM1./WE;
  connect abus[0] -> ROM1.A0;
  connect abus[1] -> ROM1.A1;
  connect abus[2] -> ROM1.A2;
  connect abus[3] -> ROM1.A3;
  connect abus[4] -> ROM1.A4;
  connect abus[5] -> ROM1.A5;
  connect abus[6] -> ROM1.A6;
  connect abus[7] -> ROM1.A7;
  connect abus[8] -> ROM1.A8;
  connect abus[9] -> ROM1.A9;
  connect abus[10] -> ROM1.A10;
  connect abus[11] -> ROM1.A11;
  connect abus[12] -> ROM1.A12;
  connect abus[13] -> ROM1.A13;
  connect abus[14] -> ROM1.A14;
  connect ROM1."I/O0" -> dbus[0];
  connect ROM1."I/O1" -> dbus[1];
  connect ROM1."I/O2" -> dbus[2];
  connect ROM1."I/O3" -> dbus[3];
  connect ROM1."I/O4" -> dbus[4];
  connect ROM1."I/O5" -> dbus[5];
  connect ROM1."I/O6" -> dbus[6];
  connect ROM1."I/O7" -> dbus[7];

  -- RAM: /CE = /A15 (A15=1 selects RAM)
  connect a15_n -> RAM1./CE;
  connect gnd -> RAM1./OE;
  connect wr_dir -> RAM1./WE;
  connect abus[0] -> RAM1.A0;
  connect abus[1] -> RAM1.A1;
  connect abus[2] -> RAM1.A2;
  connect abus[3] -> RAM1.A3;
  connect abus[4] -> RAM1.A4;
  connect abus[5] -> RAM1.A5;
  connect abus[6] -> RAM1.A6;
  connect abus[7] -> RAM1.A7;
  connect abus[8] -> RAM1.A8;
  connect abus[9] -> RAM1.A9;
  connect abus[10] -> RAM1.A10;
  connect abus[11] -> RAM1.A11;
  connect abus[12] -> RAM1.A12;
  connect abus[13] -> RAM1.A13;
  connect abus[14] -> RAM1.A14;
  connect RAM1."I/O0" -> dbus[0];
  connect RAM1."I/O1" -> dbus[1];
  connect RAM1."I/O2" -> dbus[2];
  connect RAM1."I/O3" -> dbus[3];
  connect RAM1."I/O4" -> dbus[4];
  connect RAM1."I/O5" -> dbus[5];
  connect RAM1."I/O6" -> dbus[6];
  connect RAM1."I/O7" -> dbus[7];

  -- U7 bus bridge
  connect buf_oe_n -> U7./OE;
  connect wr_dir -> U7.DIR;
  connect dbus[0] -> U7.A1;
  connect dbus[1] -> U7.A2;
  connect dbus[2] -> U7.A3;
  connect dbus[3] -> U7.A4;
  connect dbus[4] -> U7.A5;
  connect dbus[5] -> U7.A6;
  connect dbus[6] -> U7.A7;
  connect dbus[7] -> U7.A8;

  -- Boundary port bindings
  connect T2 -> t2;
  connect XOR_MODE -> xor_mode;
  connect /ADDR_MODE -> addr_mode_n;
  connect /AC_WR -> ac_wr_n;
  connect IBUS -> ibus;
  connect IRL -> irl;
  connect PC_HIGH -> pc_high;
  connect WR_DIR -> wr_dir;
  connect BUF_OE_N -> buf_oe_n;
  connect dp -> DP;
  connect abus -> ABUS;
  connect dbus -> DBUS;

  -- Derived signals
  derive dp_load_eq = t2 & xor_mode & addr_mode_n & ac_wr_n;
  derive rom_selected = ~a15;
  derive ram_selected = a15;

  -- Stimulus: input presets
  input setdp_valid {
    set ibus = 0x80;       -- DP value to load (set data first)
    set xor_mode = 1;
    set addr_mode_n = 1;   -- /ADDR_MODE=1 (fetch mode, not data)
    set ac_wr_n = 1;       -- /AC_WR=1 (not writing AC)
    set t2 = 1;            -- T2 last: completes dp_load AND gate
  }

  input setdp_blocked_ac_wr {
    set t2 = 1;
    set xor_mode = 1;
    set addr_mode_n = 1;
    set ac_wr_n = 0;       -- AC_WR active blocks SETDP
    set ibus = 0x80;
  }

  input data_access_ram {
    set t2 = 1;
    set xor_mode = 0;
    set addr_mode_n = 0;   -- /ADDR_MODE=0 (data access)
    set ac_wr_n = 1;
    set irl = 0x10;        -- Low address
    set wr_dir = 0;        -- Read
    set buf_oe_n = 0;
  }

  input data_access_rom {
    set t2 = 1;
    set xor_mode = 0;
    set addr_mode_n = 0;
    set ac_wr_n = 1;
    set irl = 0x10;
    set wr_dir = 0;
    set buf_oe_n = 0;
  }

  -- Stimulus: reset
  reset power_on {
    set t2 = 0;
    set xor_mode = 0;
    set addr_mode_n = 1;
    set ac_wr_n = 1;
    set ibus = 0x00;
    set irl = 0x00;
    set pc_high = 0x00;
    set wr_dir = 0;
    set buf_oe_n = 0;
    settle;
  }

  -- Sequence: SETDP then data access
  sequence setdp_then_read after power_on {
    -- SETDP $80
    apply setdp_valid;
    set t2 = 1; settle;
    set t2 = 0; settle;
    expect dp == 0x80;

    -- Data access at {DP=$80, IRL=$10} = address $8010 (RAM)
    apply data_access_ram;
    set irl = 0x10;
    settle;
    expect abus[15] == 1;    -- A15=1 → RAM selected
  }

  -- Clock profiles
  clock_profile manual {
    -- No clock; DP_Load is derived from combinational decode
  }

  clock_profile target_5mhz {
    -- DP_Load pulses within T2 phase of 200ns system clock
  }

  -- Edge criteria
  edge_criteria U32 {
    trigger rising;
    non_trigger hold;
  }

  edge_criteria U33 {
    trigger none;
  }

  edge_criteria U29 {
    trigger none;
    level_control S;
  }

  edge_criteria U30 {
    trigger none;
    level_control S;
  }

  edge_criteria ROM1 {
    trigger none;
    level_control /CE, active_low;
  }

  edge_criteria RAM1 {
    trigger none;
    level_control /CE, active_low;
  }

  -- Bus safety
  bus_safety dbus {
    reject multi_driver;
  }

  -- Timing checks
  timing_check setdp_decode {
    from t2;
    to U33.1Y;
    expect 15ns;
    limit 25ns;
  }

  timing_check dp_to_abus {
    from U32.1Q;
    through U29.1A;
    to U29.1Y;
    expect 20ns;
    limit 35ns;
  }

  timing_check rom_access {
    from ROM1.A0;
    to ROM1."I/O0";
    expect 70ns;
    limit 70ns;
  }

  timing_check ram_access {
    from RAM1.A0;
    to RAM1."I/O0";
    expect 70ns;
    limit 70ns;
  }

  -- Observation
  probe dp_val, dp;
  probe dp_ld, dp_load;
  probe address, abus;
  probe data_bus, dbus;
  probe a15_sel, a15;
  display dp_val as value, { "label": "DP (data page)", "radix": "hex" };
  display dp_ld as waveform, { "label": "DP_Load" };
  display address as value, { "label": "ABUS", "radix": "hex", "width": 16 };
  display data_bus as value, { "label": "DBUS", "radix": "hex" };
  display a15_sel as led, { "label": "A15 (0=ROM, 1=RAM)" };

  -- Tests
  test setdp_valid_loads {
    reset power_on;
    apply setdp_valid;
    set t2 = 1; settle;     -- DP_Load goes HIGH
    set t2 = 0; settle;     -- DP_Load falls, captures on rising
    assert dp_val == 0x80;
  }

  test setdp_blocked_by_ac_wr {
    reset power_on;
    apply setdp_blocked_ac_wr;
    set t2 = 1; settle;
    set t2 = 0; settle;
    assert dp_val == 0x00;   -- Not loaded: /AC_WR=0 blocks
  }

  test setdp_blocked_by_addr_mode {
    reset power_on;
    set t2 = 1;
    set xor_mode = 1;
    set addr_mode_n = 0;    -- /ADDR_MODE=0 (data access) blocks
    set ac_wr_n = 1;
    set ibus = 0x80;
    settle;
    set t2 = 0; settle;
    assert dp_val == 0x00;
  }

  test ram_selected_when_a15_high {
    reset power_on;
    -- Set DP to $80 first
    apply setdp_valid;
    set t2 = 1; settle; set t2 = 0; settle;
    -- Now data access: {DP=$80, IRL=$10} = $8010
    apply data_access_ram;
    set irl = 0x10;
    settle;
    assert a15_sel == 1;     -- A15=1 → RAM
    assert address == 0x8010;
  }

  test rom_selected_when_a15_low {
    reset power_on;
    -- DP stays $00, IRL=$10 → address $0010
    apply data_access_rom;
    set irl = 0x10;
    settle;
    assert a15_sel == 0;     -- A15=0 → ROM
    assert address == 0x0010;
  }

  test boundary_7fff_is_rom {
    reset power_on;
    -- Set DP=$7F, IRL=$FF → address $7FFF
    apply setdp_valid;
    set ibus = 0x7F;
    set t2 = 1; settle; set t2 = 0; settle;
    apply data_access_rom;
    set irl = 0xFF;
    settle;
    assert a15_sel == 0;     -- Still ROM
    assert address == 0x7FFF;
  }

  test boundary_8000_is_ram {
    reset power_on;
    -- Set DP=$80, IRL=$00 → address $8000
    apply setdp_valid;
    set ibus = 0x80;
    set t2 = 1; settle; set t2 = 0; settle;
    apply data_access_ram;
    set irl = 0x00;
    settle;
    assert a15_sel == 1;     -- RAM
    assert address == 0x8000;
  }
}
