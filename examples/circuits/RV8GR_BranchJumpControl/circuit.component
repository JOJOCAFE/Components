use standard.digital as digital;

component:component RV8GR_BranchJumpControl is components.digital {
  title "RV8GR branch and jump PC load control (U24+U28+U27+U26)";

  -- Public boundary ports
  port T0 : digital, input;
  port T1 : digital, input;
  port T2 : digital, input;
  port JMP : digital, input;
  port BR : digital, input;
  port ALU_SUB : digital, input;
  port Z_flag : digital, input;
  port /PC_LD : digital, output;

  -- Devices
  device U24, digital.74HC04;    -- NOT gates: /JUMP = NOT(JMP)
  device U28, digital.74HC86;    -- XOR: Z_match = Z_flag XOR ALU_SUB
  device U27, digital.74HC00;    -- NAND: branch-taken logic
  device U26, digital.74HC00;    -- NAND: /PC_LD = NAND(T2, PC_LOAD_COND)

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net t0 : digital;
  net t1 : digital;
  net t2 : digital;
  net jmp : digital;
  net br : digital;
  net alu_sub : digital;
  net z_flag : digital;
  net z_match : digital;
  net br_taken_n : digital;
  net jmp_n : digital;
  net pc_load_cond : digital;
  net pc_ld_n : digital;

  -- Power
  connect vcc -> U24.VCC;
  connect vcc -> U28.VCC;
  connect vcc -> U27.VCC;
  connect vcc -> U26.VCC;
  connect gnd -> U24.GND;
  connect gnd -> U28.GND;
  connect gnd -> U27.GND;
  connect gnd -> U26.GND;

  -- Z_match = Z_flag XOR ALU_SUB (U28 gate 1)
  -- BEQ: SUB=0 → Z_match=Z_flag (load if Z=1)
  -- BNE: SUB=1 → Z_match=NOT(Z_flag) (load if Z=0)
  connect z_flag -> U28.1A;
  connect alu_sub -> U28.1B;
  connect U28.1Y -> z_match;

  -- BR_TAKEN = BR AND Z_match
  -- Using NAND: /BR_TAKEN = NAND(BR, Z_match)
  connect br -> U27.1A;
  connect z_match -> U27.1B;
  connect U27.1Y -> br_taken_n;

  -- /JMP = NOT(JMP) via U24
  connect jmp -> U24.1A;
  connect U24.1Y -> jmp_n;

  -- PC_LOAD_COND = JMP OR BR_TAKEN = NAND(/JMP, /BR_TAKEN)
  connect jmp_n -> U27.2A;
  connect br_taken_n -> U27.2B;
  connect U27.2Y -> pc_load_cond;

  -- /PC_LD = NAND(T2, PC_LOAD_COND) — only LOW during T2
  connect t2 -> U26.1A;
  connect pc_load_cond -> U26.1B;
  connect U26.1Y -> pc_ld_n;

  -- Boundary port bindings
  connect T0 -> t0;
  connect T1 -> t1;
  connect T2 -> t2;
  connect JMP -> jmp;
  connect BR -> br;
  connect ALU_SUB -> alu_sub;
  connect Z_flag -> z_flag;
  connect pc_ld_n -> /PC_LD;

  -- Derived signals (Boolean equations)
  derive z_match_eq = z_flag ^ alu_sub;
  derive br_taken = br & z_match;
  derive pc_load_cond_eq = jmp | br_taken;
  derive pc_ld_active = t2 & pc_load_cond;

  -- Stimulus: input presets
  input nop_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 0;
    set br = 0;
    set alu_sub = 0;
    set z_flag = 0;
  }

  input jump_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 1;
    set br = 0;
    set alu_sub = 0;
    set z_flag = 0;
  }

  input beq_taken_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 0;
    set br = 1;
    set alu_sub = 0;     -- BEQ: SUB=0
    set z_flag = 1;      -- Z=1 → taken
  }

  input beq_not_taken_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 0;
    set br = 1;
    set alu_sub = 0;     -- BEQ: SUB=0
    set z_flag = 0;      -- Z=0 → not taken
  }

  input bne_taken_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 0;
    set br = 1;
    set alu_sub = 1;     -- BNE: SUB=1
    set z_flag = 0;      -- Z=0 → taken (inverted)
  }

  input bne_not_taken_t2 {
    set t0 = 0;
    set t1 = 0;
    set t2 = 1;
    set jmp = 0;
    set br = 1;
    set alu_sub = 1;     -- BNE: SUB=1
    set z_flag = 1;      -- Z=1 → not taken (inverted)
  }

  input fetch_t0 {
    set t0 = 1;
    set t1 = 0;
    set t2 = 0;
    set jmp = 1;
    set br = 1;
    set alu_sub = 0;
    set z_flag = 1;
  }

  input fetch_t1 {
    set t0 = 0;
    set t1 = 1;
    set t2 = 0;
    set jmp = 1;
    set br = 1;
    set alu_sub = 0;
    set z_flag = 1;
  }

  -- Stimulus: reset (idle state)
  reset idle {
    set t0 = 0;
    set t1 = 0;
    set t2 = 0;
    set jmp = 0;
    set br = 0;
    set alu_sub = 0;
    set z_flag = 0;
    settle;
    expect pc_ld_n == 1;
  }

  -- Edge criteria (all combinational — no clocked elements)
  edge_criteria U24 {
    trigger none;
  }

  edge_criteria U28 {
    trigger none;
  }

  edge_criteria U27 {
    trigger none;
  }

  edge_criteria U26 {
    trigger none;
  }

  -- Timing checks
  timing_check jmp_to_pc_ld {
    from jmp;
    through U24.1Y;
    through U27.2Y;
    to U26.1Y;
    expect 25ns;
    limit 40ns;
  }

  timing_check branch_critical_path {
    from z_flag;
    through U28.1Y;
    through U27.1Y;
    through U27.2Y;
    to U26.1Y;
    expect 35ns;
    limit 55ns;
  }

  -- Observation
  probe pc_ld, pc_ld_n;
  probe z_m, z_match;
  probe br_tk, br_taken;
  probe load_cond, pc_load_cond;
  display pc_ld as led, { "label": "/PC_LD (active LOW = load)" };
  display z_m as led, { "label": "Z_match" };
  display br_tk as led, { "label": "Branch taken" };
  display load_cond as led, { "label": "PC_LOAD_COND" };

  -- Tests
  test t0_never_loads {
    apply fetch_t0;
    settle;
    assert pc_ld == 1;   -- /PC_LD stays HIGH (inactive)
  }

  test t1_never_loads {
    apply fetch_t1;
    settle;
    assert pc_ld == 1;   -- /PC_LD stays HIGH (inactive)
  }

  test nop_no_load {
    apply nop_t2;
    settle;
    assert pc_ld == 1;
    assert load_cond == 0;
  }

  test unconditional_jump {
    apply jump_t2;
    settle;
    assert pc_ld == 0;   -- /PC_LD LOW = load PC
    assert load_cond == 1;
  }

  test beq_taken_z_set {
    apply beq_taken_t2;
    settle;
    assert z_m == 1;
    assert br_tk == 1;
    assert pc_ld == 0;
  }

  test beq_not_taken_z_clear {
    apply beq_not_taken_t2;
    settle;
    assert z_m == 0;
    assert br_tk == 0;
    assert pc_ld == 1;
  }

  test bne_taken_z_clear {
    apply bne_taken_t2;
    settle;
    assert z_m == 1;     -- XOR(0,1) = 1
    assert br_tk == 1;
    assert pc_ld == 0;
  }

  test bne_not_taken_z_set {
    apply bne_not_taken_t2;
    settle;
    assert z_m == 0;     -- XOR(1,1) = 0
    assert br_tk == 0;
    assert pc_ld == 1;
  }

  test jmp_and_br_overlap {
    -- Both JMP and BR set: JMP dominates via OR
    set t2 = 1;
    set jmp = 1;
    set br = 1;
    set alu_sub = 0;
    set z_flag = 0;      -- Branch not taken, but JMP still loads
    settle;
    assert pc_ld == 0;
  }
}
