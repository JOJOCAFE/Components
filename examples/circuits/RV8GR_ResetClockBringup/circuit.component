use standard.digital as digital;
use standard.virtual as virtual;

component:component RV8GR_ResetClockBringup is components.digital {
  title "RV8GR reset and clock bring-up (ring counter + PC chain)";

  -- Public boundary ports
  port CLK : digital, input;
  port /RST : digital, input;
  port T0 : digital, output;
  port T1 : digital, output;
  port T2 : digital, output;
  port PC[16] : digital, output;

  -- Devices
  device U8, digital.74HC164;    -- Ring counter shift register
  device U24, digital.74HC04;    -- Feedback inverters
  device U25, digital.74HC32;    -- PC_INC = T0 OR T1
  device U1, digital.74HC161;    -- PC bits 0-3
  device U2, digital.74HC161;    -- PC bits 4-7
  device U3, digital.74HC161;    -- PC bits 8-11
  device U4, digital.74HC161;    -- PC bits 12-15

  -- Virtual probes
  device PHASE_MON, virtual.Probe;
  device PC_MON, virtual.Probe;

  -- Internal nets
  net vcc : power;
  net gnd : power;
  net clk : digital;
  net rst_n : digital;
  net t0 : digital;
  net t1 : digital;
  net t2 : digital;
  net not_t0 : digital;
  net not_t1 : digital;
  net pc_inc : digital;
  bus pc[16] : digital;
  net rco0 : digital;
  net rco1 : digital;
  net rco2 : digital;

  -- Power
  connect vcc -> U8.VCC;
  connect vcc -> U24.VCC;
  connect vcc -> U25.VCC;
  connect vcc -> U1.VCC;
  connect vcc -> U2.VCC;
  connect vcc -> U3.VCC;
  connect vcc -> U4.VCC;
  connect gnd -> U8.GND;
  connect gnd -> U24.GND;
  connect gnd -> U25.GND;
  connect gnd -> U1.GND;
  connect gnd -> U2.GND;
  connect gnd -> U3.GND;
  connect gnd -> U4.GND;

  -- Ring counter: U8 + U24 feedback
  connect clk -> U8.CLK;
  connect rst_n -> U8./CLR;
  connect U8.QA -> t0;
  connect U8.QB -> t1;
  connect U8.QC -> t2;
  connect t0 -> U24.1A;
  connect U24.1Y -> not_t0;
  connect not_t0 -> U8.A;
  connect t1 -> U24.2A;
  connect U24.2Y -> not_t1;
  connect not_t1 -> U8.B;

  -- PC_INC = T0 OR T1 (U25 gate 1)
  connect t0 -> U25.1A;
  connect t1 -> U25.1B;
  connect U25.1Y -> pc_inc;

  -- PC counter chain: clock, reset, count enable
  connect clk -> U1.CLK;
  connect clk -> U2.CLK;
  connect clk -> U3.CLK;
  connect clk -> U4.CLK;
  connect rst_n -> U1./CLR;
  connect rst_n -> U2./CLR;
  connect rst_n -> U3./CLR;
  connect rst_n -> U4./CLR;

  -- /LOAD tied HIGH (no parallel load in bring-up)
  connect vcc -> U1./LOAD;
  connect vcc -> U2./LOAD;
  connect vcc -> U3./LOAD;
  connect vcc -> U4./LOAD;

  -- Count enable from PC_INC
  connect pc_inc -> U1.ENP;
  connect pc_inc -> U1.ENT;
  connect pc_inc -> U2.ENP;
  connect pc_inc -> U3.ENP;
  connect pc_inc -> U4.ENP;

  -- RCO carry chain
  connect U1.RCO -> rco0;
  connect rco0 -> U2.ENT;
  connect U2.RCO -> rco1;
  connect rco1 -> U3.ENT;
  connect U3.RCO -> rco2;
  connect rco2 -> U4.ENT;

  -- PC outputs
  connect U1.QA -> pc[0];
  connect U1.QB -> pc[1];
  connect U1.QC -> pc[2];
  connect U1.QD -> pc[3];
  connect U2.QA -> pc[4];
  connect U2.QB -> pc[5];
  connect U2.QC -> pc[6];
  connect U2.QD -> pc[7];
  connect U3.QA -> pc[8];
  connect U3.QB -> pc[9];
  connect U3.QC -> pc[10];
  connect U3.QD -> pc[11];
  connect U4.QA -> pc[12];
  connect U4.QB -> pc[13];
  connect U4.QC -> pc[14];
  connect U4.QD -> pc[15];

  -- Parallel load data tied to GND (unused in bring-up)
  connect gnd -> U1.A;
  connect gnd -> U1.B;
  connect gnd -> U1.C;
  connect gnd -> U1.D;
  connect gnd -> U2.A;
  connect gnd -> U2.B;
  connect gnd -> U2.C;
  connect gnd -> U2.D;
  connect gnd -> U3.A;
  connect gnd -> U3.B;
  connect gnd -> U3.C;
  connect gnd -> U3.D;
  connect gnd -> U4.A;
  connect gnd -> U4.B;
  connect gnd -> U4.C;
  connect gnd -> U4.D;

  -- Boundary port bindings
  connect CLK -> clk;
  connect /RST -> rst_n;
  connect t0 -> T0;
  connect t1 -> T1;
  connect t2 -> T2;
  connect pc -> PC;

  -- Derived signals
  derive serial_in = ~t0 & ~t1;
  derive pc_inc_equation = t0 | t1;

  -- Stimulus: clock
  clock sys_clk, clk, { "period_ns": 200, "initial": 0 };

  -- Stimulus: input presets
  input reset_held {
    set rst_n = 0;
  }

  input running {
    set rst_n = 1;
  }

  -- Stimulus: interactive controls
  channel sw_reset, rst_n, { "kind": "button", "initial": 1, "label": "/RST (press=reset)" };
  channel sw_clock, clk, { "kind": "button", "initial": 0, "label": "CLK (manual push)" };

  -- Stimulus: reset
  reset power_on {
    set rst_n = 0;
    settle;
    set rst_n = 1;
    settle;
    expect t0 == 0;
    expect t1 == 0;
    expect t2 == 0;
    expect pc == 0x0000;
  }

  -- Stimulus: step sequences
  step push_one_clock {
    pulse clk;
    settle;
    probe;
  }

  -- Sequence: reset → 6 clocks showing T0/T1/T2 + PC increments
  sequence bringup_proof after power_on {
    -- Clock 1: T0 rises, PC still 0 (PC_INC was 0 before this edge)
    clock sys_clk; expect t0 == 1, t1 == 0, t2 == 0; expect pc == 0x0000;
    -- Clock 2: T1 rises, PC increments (old T0 was 1 → PC_INC was 1)
    clock sys_clk; expect t0 == 0, t1 == 1, t2 == 0; expect pc == 0x0001;
    -- Clock 3: T2 rises, PC increments (old T1 was 1 → PC_INC was 1)
    clock sys_clk; expect t0 == 0, t1 == 0, t2 == 1; expect pc == 0x0002;
    -- Clock 4: T0 again, PC holds (old T2 → PC_INC was 0)
    clock sys_clk; expect t0 == 1, t1 == 0, t2 == 0; expect pc == 0x0002;
    -- Clock 5: T1 again, PC increments
    clock sys_clk; expect t0 == 0, t1 == 1, t2 == 0; expect pc == 0x0003;
    -- Clock 6: T2 again, PC increments
    clock sys_clk; expect t0 == 0, t1 == 0, t2 == 1; expect pc == 0x0004;
  }

  -- Clock profiles
  clock_profile manual {
    clock sys_clk, clk, { "period_ns": 1000000 };
  }

  clock_profile target_5mhz {
    clock sys_clk, clk, { "period_ns": 200 };
  }

  -- Edge criteria
  edge_criteria U8 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  edge_criteria U1 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  edge_criteria U2 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  edge_criteria U3 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  edge_criteria U4 {
    trigger rising;
    non_trigger hold;
    async_override /CLR, clear_to_zero;
  }

  -- Safety policies
  policy phase_one_hot {
    reject (t0 & t1) == 1;
    reject (t0 & t2) == 1;
    reject (t1 & t2) == 1;
  }

  policy pc_no_unknown {
    reject pc has unknown;
  }

  -- Timing checks
  timing_check ring_feedback {
    from U8.QA;
    through U24.1A;
    to U8.A;
    expect 12ns;
    limit 20ns;
  }

  timing_check phase_to_pc_inc {
    from U25.1Y;
    to U1.ENP;
    expect 15ns;
    limit 25ns;
  }

  -- Observation
  probe phase_t0, t0;
  probe phase_t1, t1;
  probe phase_t2, t2;
  probe pc_val, pc;
  probe inc_signal, pc_inc;
  display phase_t0 as waveform, { "label": "T0" };
  display phase_t1 as waveform, { "label": "T1" };
  display phase_t2 as waveform, { "label": "T2" };
  display pc_val as value, { "label": "PC", "radix": "hex", "width": 16 };
  display inc_signal as waveform, { "label": "PC_INC (T0|T1)" };

  -- Tests
  test reset_idle_all_zero {
    apply reset_held;
    settle;
    assert phase_t0 == 0;
    assert phase_t1 == 0;
    assert phase_t2 == 0;
    assert pc_val == 0x0000;
  }

  test reset_release_no_advance {
    apply reset_held;
    settle;
    apply running;
    settle;
    -- No clock edge: nothing changes
    assert phase_t0 == 0;
    assert pc_val == 0x0000;
  }

  test first_clock_gives_t0 {
    reset power_on;
    pulse clk; settle;
    assert phase_t0 == 1;
    assert phase_t1 == 0;
    assert phase_t2 == 0;
    assert pc_val == 0x0000;
  }

  test pc_increments_when_t0_or_t1_was_high {
    reset power_on;
    -- Clock 1 → T0 (PC still 0)
    pulse clk; settle;
    assert pc_val == 0x0000;
    -- Clock 2 → T1 (PC increments because old T0 was 1)
    pulse clk; settle;
    assert pc_val == 0x0001;
    -- Clock 3 → T2 (PC increments because old T1 was 1)
    pulse clk; settle;
    assert pc_val == 0x0002;
    -- Clock 4 → T0 (PC holds because old T2 was 1 → PC_INC=0)
    pulse clk; settle;
    assert pc_val == 0x0002;
  }

  test works_at_5mhz {
    use clock_profile target_5mhz;
    reset power_on;
    clock sys_clk 6;
    assert phase_t2 == 1;
    assert pc_val == 0x0004;
  }
}
